# Copy to .env.local and fill in. NEVER commit real values.
# Only NEXT_PUBLIC_* values are exposed to the browser — no secrets there.

# ---------------------------------------------------------------- Application
# Official domain once confirmed (e.g. https://www.example.ro). Until set,
# the site is served with noindex and robots.txt disallows everything.
NEXT_PUBLIC_SITE_URL=

# VSL video (YouTube URL or https .mp4). Leave empty until supplied.
NEXT_PUBLIC_VSL_URL=
# YouTube video of a physical meeting. Leave empty until supplied.
NEXT_PUBLIC_MEETING_YOUTUBE_URL=

# ---------------------------------------------------------------- Membership
G33_INITIAL_MEMBER_COUNT=130
G33_MAX_MEMBERS=200
# Days a payment link stays valid (and reserves a seat).
G33_PAYMENT_LINK_TTL_DAYS=7

# ---------------------------------------------------------------- Database (required in production)
# PostgreSQL connection string, e.g. postgres://user:pass@host:5432/db?sslmode=require
DATABASE_URL=
# Optional: max pool size per server instance (default 5)
# DATABASE_POOL_MAX=5
# Local dev without DATABASE_URL uses an embedded Postgres in .data/pglite.
# G33_ALLOW_LOCAL_DB=true   # allow embedded DB with `npm start` (never in real production)

# ---------------------------------------------------------------- Google Sheets
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Aplicatii G33
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the JSON key, keeping the \n sequences, in double quotes:
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ---------------------------------------------------------------- Stripe (server-only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs from the Stripe dashboard (price_...).
STRIPE_PRICE_3_MONTHS=
STRIPE_PRICE_YEARLY=
STRIPE_PRICE_LIFETIME=
# Payment type per plan once the owner confirms it: "payment" (one-time) or "subscription".
# Checkout stays disabled for a plan until this is set.
G33_PLAN_3_MONTHS_MODE=
G33_PLAN_YEARLY_MODE=
G33_PLAN_LIFETIME_MODE=
# Safety switch: a live key (sk_live_) is refused in production unless this is "true".
G33_LIVE_PAYMENTS_ENABLED=false

# ---------------------------------------------------------------- Admin
# Generate with: npm run admin:hash -- "your-strong-password"
# local dev admin password (this machine only): f-9qeW2Q6bQI768T
ADMIN_PASSWORD_HASH=scrypt$JBUL6QCYzfZZBZSZqEKYLg==$6N+eNh4adG76ddX9lljdHuamMLDyjVfy+sRgZgtRonWh1LmXWLI7dAtZvnbgaFdZcIi0OsPaqfdN7CeJyvWmow==
# At least 32 random characters, e.g. from: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=6ADiWEOiitB9TT6kMpJvpw8NBd62sMu-ClhPZnNjRZhTrxZIrnUowfGF8efX_vRZ
# Optional salt for hashed rate-limit keys (defaults to ADMIN_SESSION_SECRET)
RATE_LIMIT_SALT=
